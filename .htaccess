# Funkfeld — Root-Schutz

# Kein Verzeichnis-Listing
Options -Indexes

# HTTPS erzwingen (loop-sicher, auch hinter TLS-terminierendem Proxy).
# Falls der Webspace ausnahmsweise kein HTTPS hat, diesen Block auskommentieren.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Custom-Fläche (action=custom_render) markieren → globale CSP wird dafür ausgesetzt (eigene Sandbox-CSP via PHP)
    RewriteCond %{QUERY_STRING} (^|&)action=custom_render(&|$)
    RewriteRule ^ - [E=FF_RAWHTML:1]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Doku-/Datendateien nicht direkt ausliefern
<FilesMatch "\.(json|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# PWA-Manifest: korrekter MIME-Typ (mancher Apache kennt .webmanifest nicht)
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# GZIP-Kompression — spart bei den Text-Assets (JS/CSS) und den JSON-API-Antworten
# typisch 65–75 % Transfervolumen. Auf Servern ohne mod_deflate schweigt der Block.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Service Worker: immer frisch prüfen — sw.js darf nie an der 1-Jahres-JS-Regel unten
# hängen bleiben, sonst verteilen sich SW-Änderungen auf alten Browsern erst nach 24 h.
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache"
    </IfModule>
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
</Files>

# Statische Assets lange cachen — unbedenklich, weil alle Verweise einen ?v=-Cache-Buster tragen.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Ein paar einfache Sicherheits-Header
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
    Header set Strict-Transport-Security "max-age=31536000"
    # FF_RAWHTML wird oben per mod_rewrite für action=custom_render gesetzt → globale CSP aussetzen.
    # Karte: Leaflet liegt lokal (assets/vendor/leaflet) — kein CDN in der CSP mehr.
    # img-src bleibt https:, weil die Kartenkacheln von OSM/Esri/CartoDB kommen.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" env=!FF_RAWHTML
</IfModule>
